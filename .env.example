# Base URL the SPA uses to call the API.
#
# Default "/" + "/api" suffix = same-origin. Requests are served by:
#   - production: nginx inside the container, which reverse-proxies /api/*
#     to the upstream set by the API_UPSTREAM build arg.
#   - dev / preview: the Vite dev server proxy with the same behavior.
#
# In both cases the browser never makes a cross-origin call, so the upstream
# API does not need to send CORS headers.
#
# Override to a full URL only if you've confirmed that target sends proper
# Access-Control-Allow-Origin headers for this origin.
VITE_API_URL=/api

# Where /api/* proxies to. Used by vite.config.ts (dev/preview) and by the
# Dockerfile's nginx template (production). Defaults to the public Modal API.
# API_UPSTREAM=https://rinabuoy13--khparser-api.modal.run
